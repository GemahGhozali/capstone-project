generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier          String               @unique @db.VarChar
  password            String
  namaLengkap         String               @map("nama_lengkap") @db.VarChar
  alamatEmail         String               @unique @map("alamat_email") @db.VarChar
  fotoProfil          String?              @map("foto_profil")
  isActive            Boolean              @default(true) @map("is_active")
  isAccountReset      Boolean              @default(false) @map("is_account_reset")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  mahasiswa           Mahasiswa?
  dosen               Dosen?
  userRoles           UserRole[]
  activityLogs        ActivityLog[]
  passwordResetTokens PasswordResetToken[]

  @@map("user")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_token")
}

model Role {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama       String     @unique @db.VarChar
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  userRoles  UserRole[]

  @@map("role")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_role")
}

model Prodi {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama      String   @unique @db.VarChar
  kode      String   @unique @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dosen     Dosen[]

  @@map("prodi")
}

model Kelas {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama      String      @db.VarChar(20)
  kode      String      @unique @db.VarChar(20)
  angkatan  Int         @db.SmallInt
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  mahasiswa Mahasiswa[]

  @@unique([nama, angkatan])
  @@map("kelas")
}

model Mahasiswa {
  id              String              @id @db.Uuid
  nim             String              @unique @db.VarChar
  tanggalMasuk    DateTime            @map("tanggal_masuk") @db.Date
  status          StatusMahasiswa     @default(Aktif)
  dosenId         String?             @map("dosen_id") @db.Uuid
  kelasId         String              @map("kelas_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  user            User                @relation(fields: [id], references: [id], onDelete: Cascade)
  dosen           Dosen?              @relation(fields: [dosenId], references: [id], onDelete: SetNull)
  kelas           Kelas               @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  anggotaTim      AnggotaTim?
  resume          Resume?
  bookings        BookingBimbingan[]
  responKuesioner ResponKuesioner[]

  @@map("mahasiswa")
}

model Dosen {
  id                    String                  @id @db.Uuid
  nip                   String                  @unique @db.VarChar
  bidangKeahlian        String                  @map("bidang_keahlian") @db.VarChar
  status                StatusDosen             @default(Aktif)
  prodiId               String                  @map("prodi_id") @db.Uuid
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  user                  User                    @relation(fields: [id], references: [id], onDelete: Cascade)
  prodi                 Prodi                   @relation(fields: [prodiId], references: [id], onDelete: Restrict)
  dosenPembimbingDetail DosenPembimbingDetail?
  proposalReviews       ProposalReview[]
  resumes               Resume[]
  resumeReviews         ResumeReview[]
  jadwalBimbingan       JadwalBimbingan[]
  mahasiswaBimbingan    Mahasiswa[]

  @@map("dosen")
}

model DosenPembimbingDetail {
  id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dosenId        String                      @unique @map("dosen_id") @db.Uuid
  batasBimbingan Int                         @map("batas_bimbingan")
  status         StatusDosenPembimbingDetail @default(Buka)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  dosen          Dosen                       @relation(fields: [dosenId], references: [id], onDelete: Cascade)

  @@map("dosen_pembimbing_detail")
}

model Tim {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama       String       @db.VarChar
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  anggotaTim AnggotaTim[]
  proposal   Proposal?

  @@map("tim")
}

model AnggotaTim {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timId             String            @map("tim_id") @db.Uuid
  mahasiswaId       String            @unique @map("mahasiswa_id") @db.Uuid
  peran             PeranAnggotaTim
  kategoriCapstone  KategoriCapstone  @map("kategori_capstone")
  statusPersetujuan StatusPersetujuan @default(Menunggu) @map("status_persetujuan")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  tim               Tim               @relation(fields: [timId], references: [id], onDelete: Cascade)
  mahasiswa         Mahasiswa         @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)

  @@map("anggota_tim")
}

model Proposal {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timId     String           @unique @map("tim_id") @db.Uuid
  judul     String           @db.VarChar
  mitra     String           @db.VarChar
  filePath  String           @map("file_path")
  fileName  String           @db.VarChar @map("file_name")
  fileSize  Int              @map("file_size")
  status    StatusProposal   @default(Menunggu)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tim       Tim              @relation(fields: [timId], references: [id], onDelete: Cascade)
  reviews   ProposalReview[]
  resumes   Resume[]

  @@map("proposal")
}

model ProposalReview {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalId String         @map("proposal_id") @db.Uuid
  dosenId    String?        @map("dosen_id") @db.Uuid
  catatan    String
  status     StatusProposal
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  proposal   Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  dosen      Dosen?         @relation(fields: [dosenId], references: [id], onDelete: SetNull)

  @@map("proposal_review")
}

model Resume {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalId  String         @map("proposal_id") @db.Uuid
  mahasiswaId String         @unique @map("mahasiswa_id") @db.Uuid
  dosenId     String?        @map("dosen_id") @db.Uuid
  subjudul    String         @db.VarChar
  filePath    String         @map("file_path")
  fileName    String         @db.VarChar @map("file_name")
  fileSize    Int            @map("file_size")
  status      StatusResume   @default(Menunggu)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  proposal    Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  mahasiswa   Mahasiswa      @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  dosen       Dosen?         @relation(fields: [dosenId], references: [id], onDelete: SetNull)
  reviews     ResumeReview[]

  @@map("resume")
}

model ResumeReview {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dosenId   String?      @map("dosen_id") @db.Uuid
  resumeId  String       @map("resume_id") @db.Uuid
  catatan   String
  status    StatusResume
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  dosen     Dosen?       @relation(fields: [dosenId], references: [id], onDelete: SetNull)
  resume    Resume       @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_review")
}

model JadwalBimbingan {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dosenId   String                @map("dosen_id") @db.Uuid
  tanggal   DateTime              @db.Date
  jamMulai  DateTime              @map("jam_mulai") @db.Time
  jamTutup  DateTime              @map("jam_tutup") @db.Time
  kuota     Int
  status    StatusJadwalBimbingan @default(Aktif)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  dosen     Dosen                 @relation(fields: [dosenId], references: [id], onDelete: Cascade)
  bookings  BookingBimbingan[]

  @@map("jadwal_bimbingan")
}

model BookingBimbingan {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jadwalId           String                    @map("jadwal_id") @db.Uuid
  mahasiswaId        String                    @map("mahasiswa_id") @db.Uuid
  catatanMahasiswa   String                    @map("catatan_mahasiswa")
  catatanDosen       String?                   @map("catatan_dosen")
  status             StatusBookingBimbingan    @default(Dipesan)
  tanggalPembatalan  DateTime?                 @map("tanggal_pembatalan") @db.Timestamptz
  alasanPembatalan   String?                   @map("alasan_pembatalan")
  dibatalkanOleh     DibatalkanOleh?           @map("dibatalkan_oleh")
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  jadwal             JadwalBimbingan           @relation(fields: [jadwalId], references: [id], onDelete: Cascade)
  mahasiswa          Mahasiswa                 @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)

  @@map("booking_bimbingan")
}

model Kuesioner {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  judul     String            @db.VarChar
  deskripsi String?
  periode   String            @db.VarChar
  status    StatusKuesioner   @default(Draf)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  bagian    BagianKuesioner[]
  respon    ResponKuesioner[]

  @@map("kuesioner")
}

model BagianKuesioner {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kuesionerId String                @map("kuesioner_id") @db.Uuid
  judul       String                @db.VarChar
  urutan      Int
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  kuesioner   Kuesioner             @relation(fields: [kuesionerId], references: [id], onDelete: Cascade)
  pertanyaan  PertanyaanKuesioner[]

  @@unique([kuesionerId, urutan])
  @@map("bagian_kuesioner")
}

model PertanyaanKuesioner {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bagianId  String             @map("bagian_id") @db.Uuid
  tipe      TipePertanyaan     @default(Likert)
  teks      String
  wajib     Boolean            @default(true)
  urutan    Int
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  bagian    BagianKuesioner    @relation(fields: [bagianId], references: [id], onDelete: Cascade)
  jawaban   JawabanKuesioner[]

  @@unique([bagianId, urutan])
  @@map("pertanyaan_kuesioner")
}

model ResponKuesioner {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kuesionerId String           @map("kuesioner_id") @db.Uuid
  mahasiswaId String           @map("mahasiswa_id") @db.Uuid
  status      StatusRespon     @default(Draf)
  submittedAt DateTime?        @map("submitted_at") @db.Timestamptz
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  kuesioner Kuesioner          @relation(fields: [kuesionerId], references: [id], onDelete: Cascade)
  mahasiswa Mahasiswa          @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  jawaban   JawabanKuesioner[]

  @@unique([kuesionerId, mahasiswaId])
  @@map("respon_kuesioner")
}

model JawabanKuesioner {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responId     String            @map("respon_id") @db.Uuid
  pertanyaanId String            @map("pertanyaan_id") @db.Uuid
  nilai        Int?              @db.SmallInt
  jawabanTeks  String?           @map("jawaban_teks")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  respon     ResponKuesioner     @relation(fields: [responId], references: [id], onDelete: Cascade)
  pertanyaan PertanyaanKuesioner @relation(fields: [pertanyaanId], references: [id], onDelete: Cascade)

  @@unique([responId, pertanyaanId])
  @@map("jawaban_kuesioner")
}

model ActivityLog {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity    EntityLog
  entityId  String     @map("entity_id") @db.Uuid
  userId    String?    @map("user_id") @db.Uuid
  pesan     String
  warna     WarnaLog
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_log")
}

enum StatusMahasiswa {
  Aktif
  Nonaktif
  Arsip
}

enum StatusDosen {
  Aktif
  Nonaktif
  Pindah
}

enum StatusDosenPembimbingDetail {
  Buka
  Tutup
}

enum PeranAnggotaTim {
  Ketua
  Anggota
}

enum KategoriCapstone {
  EPD
  SM
}

enum StatusPersetujuan {
  Menunggu
  Disetujui
}

enum StatusProposal {
  Menunggu
  Disetujui
  Ditolak
  Revisi
}

enum StatusResume {
  Menunggu
  Disetujui
  Ditolak
}

enum StatusJadwalBimbingan {
  Aktif
  Ditutup
}

enum StatusBookingBimbingan {
  Dipesan
  Dibatalkan
  Selesai
}

enum StatusKuesioner {
  Draf
  Aktif
  Ditutup
}

enum TipePertanyaan {
  Likert
  Esai
}

enum StatusRespon {
  Draf
  Selesai
}

enum DibatalkanOleh {
  Mahasiswa
  Dosen
}

enum EntityLog {
  Tim
  Proposal
  Resume
}

enum WarnaLog {
  Neutral
  Danger
  Warning
  Success
  Info
}
